{
  "name": "agri-equipment-rental-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Asset-Light Farming: Optimizing Operational Costs through Managed Equipment Access - BE Major Project MVP",
  "workspaces": [
    "server",
    "apps/farmer-web",
    "apps/owner-web"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:farmer": "npm --prefix apps/farmer-web run dev",
    "dev:owner": "npm --prefix apps/owner-web run dev",
